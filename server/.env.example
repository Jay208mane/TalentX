# TalentX Server Environment Configuration Example

# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/TalentX

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Admin Seeding Credentials (for CreateAdmin script)
ADMIN_EMAIL=admin@talentx.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars

# ==============================================================================
# Generative AI Configuration (for AI Job Description Generator)
# ==============================================================================
# Supported providers: openai, gemini, groq, openrouter, custom
AI_PROVIDER=openai

# LLM Model Name (e.g., gpt-4o-mini, gemini-1.5-flash, llama-3.1-70b-versatile)
AI_MODEL=gpt-4o-mini

# Provider API Key (Required for live generation)
AI_API_KEY=your_ai_provider_api_key_here

# Optional: Custom API Base URL (for OpenAI-compatible gateways, local Ollama, etc.)
# AI_BASE_URL=https://api.openai.com/v1

# Frontend origin for Socket.IO/CORS in deployments (optional for localhost development)
# CLIENT_ORIGIN=https://your-talentx-domain.example

# Password reset mail mode:
# Development: Mailpit only; SMTP must be local on port 1025 (no credentials).
NODE_ENV=development
PASSWORD_RESET_EMAIL_MODE=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Production only: set PASSWORD_RESET_EMAIL_MODE=smtp, SMTP_USER, and SMTP_PASS.
# Never configure external SMTP for development; the backend rejects it.
# Frontend origin used to create reset links. Production must use HTTPS.
CLIENT_URL=http://localhost:5173

# Required to save encrypted freelancer payment instructions. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_DATA_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# Required to encrypt freelancer-provided GitHub fine-grained tokens at rest.
# Generate independently from the payment key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=your_separate_base64_encoded_32_byte_key
